NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Either the new publishable key (sb_publishable_...) or the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Optional: default Cloudinary account for new projects (also configurable in Settings).
# CLOUDINARY_DEFAULT_ACCOUNT=default

# Optional: additional Cloudinary accounts (id becomes the slug lowercased, e.g. STUDIO -> studio)
# CLOUDINARY_ACCOUNT_STUDIO_CLOUD_NAME=your-new-cloud-name
# CLOUDINARY_ACCOUNT_STUDIO_API_KEY=your-api-key
# CLOUDINARY_ACCOUNT_STUDIO_API_SECRET=your-api-secret
# CLOUDINARY_ACCOUNT_STUDIO_LABEL=Studio account

# Google Calendar OAuth (Settings → Connect Google Calendar)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional: canonical site URL for OAuth redirects (production custom domain).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional legacy redirect override; callback URI is derived from the request by default.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
